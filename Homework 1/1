a = float(input("Введите первое число:"))
operation = input("Выберите операцию:")
b = float(input("Введите второе число:"))

if operation == "+":
    result = a + b
elif operation == "-":
    result = a - b
elif operation == "*":
    result = a * b
elif operation == "/":
    if b != 0:
        result = a / b
    else:
        result = "Ошибка"
else:
    result = "Неизвестная операция"

print("Результат:", result) 
